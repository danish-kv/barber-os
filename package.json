{
  "name": "barbershop-os",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @barbershop-os/web dev",
    "dev:api": "pnpm --filter @barbershop-os/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:storyline": "pnpm --filter @barbershop-os/web test:storyline"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
